    clarify: [
      { input: "deploy it to the usual place", expected_intent: "clarify", expected_agent: "secretary" },
      { input: "rename the thing we talked about yesterday to the new brand", expected_intent: "clarify", expected_agent: "secretary" },
      { input: "send that to him", expected_intent: "clarify", expected_agent: "secretary" },
