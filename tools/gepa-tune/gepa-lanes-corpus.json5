      { input: "every day at 8am summarize my overnight bench results", expected_intent: "instruction", expected_agent: "secretary" },
      { input: "remember to address me as boss in every reply", expected_intent: "instruction", expected_agent: "secretary" },
      { input: "from now on, prefer local models over cloud when the task is trivial", expected_intent: "instruction", expected_agent: "secretary" },
      { input: "never suggest git push unless I explicitly ask", expected_intent: "instruction", expected_agent: "secretary" },
      { input: "going forward, file every bug you find in my repo as a GitHub issue", expected_intent: "instruction", expected_agent: "secretary" },
      { input: "standing rule: keep all responses under ten lines", expected_intent: "instruction", expected_agent: "secretary" },
      { input: "each morning, remind me of the open gate failures", expected_intent: "instruction", expected_agent: "secretary" },
