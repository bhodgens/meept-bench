    imageid: [
      { input: "look at this screenshot and tell me what error it shows", expected_intent: "imageid", expected_agent: "vision" },
      { input: "what is written on this receipt image? extract the line items", expected_intent: "imageid", expected_agent: "vision" },
      { input: "describe the contents of photo.jpg from my home dir", expected_intent: "imageid", expected_agent: "vision" },
      { input: "identify the plant species in this garden picture", expected_intent: "imageid", expected_agent: "vision" },
      { input: "read the whiteboard in this meeting photo and list the action items", expected_intent: "imageid", expected_agent: "vision" },
      { input: "what model of GPU is shown on the label in this image?", expected_intent: "imageid", expected_agent: "vision" },
      { input: "check this chart image and tell me whether the series is trending up", expected_intent: "imageid", expected_agent: "vision" },
      { input: "does this dashboard screenshot show any red panels?", expected_intent: "imageid", expected_agent: "vision" },
