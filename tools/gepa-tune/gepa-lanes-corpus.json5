{
  // Lanes missing from the meept eval corpora (14 lanes), authored for the
  // GEPA prompt-tuning run in tools/gepa-tune. Same shape as
  // testdata/eval/classifier-test-corpus.json5 so load_corpus() reads it.
  name: "GEPA lane-coverage corpus v1",
  version: "1.0",
  categories: {
    tooluse: [
      { input: "call web_fetch with url https://example.com", expected_intent: "tooluse", expected_agent: "coder" },
      { input: "run shell_execute: git status", expected_intent: "tooluse", expected_agent: "coder" },
      { input: "use the file_read tool on config.json5", expected_intent: "tooluse", expected_agent: "coder" },
      { input: "invoke json_extract on results.json with path .data[0]", expected_intent: "tooluse", expected_agent: "coder" },
      { input: "execute grep -rn TODO . via the terminal tool", expected_intent: "tooluse", expected_agent: "coder" },
      { input: "call the memory_search tool with query 'zfs snapshot plan'", expected_intent: "tooluse", expected_agent: "coder" },
      { input: "run tool http_post with body {\"ping\": true}", expected_intent: "tooluse", expected_agent: "coder" },
      { input: "use file_write at path /tmp/x.txt with contents hello", expected_intent: "tooluse", expected_agent: "coder" },
    ],
    research: [
      { input: "research the current state of sodium-ion battery commercialization and extract key players", expected_intent: "research", expected_agent: "researcher" },
      { input: "gather sources on how OpenZFS handles hole punching and pull out the technical details", expected_intent: "research", expected_agent: "researcher" },
      { input: "look up which cloud providers offer Arm instance families and tabulate pricing", expected_intent: "research", expected_agent: "researcher" },
      { input: "do a literature scan on sparse autoencoders for interpretability and list findings", expected_intent: "research", expected_agent: "researcher" },
      { input: "investigate the competitor landscape for local-first note apps and extract feature comparisons", expected_intent: "research", expected_agent: "researcher" },
      { input: "find out how many RISC-V laptops shipped in 2025 with sources", expected_intent: "research", expected_agent: "researcher" },
      { input: "research EU AI Act compliance deadlines and structure them into a timeline", expected_intent: "research", expected_agent: "researcher" },
      { input: "collect and organize data on home EV charger models and specs", expected_intent: "research", expected_agent: "researcher" },
    ],
    explore: [
      { input: "walk through the repo and explain how sessions are stored", expected_intent: "explore", expected_agent: "coder" },
      { input: "figure out where the daemon boot sequence lives without changing anything", expected_intent: "explore", expected_agent: "coder" },
      { input: "read through internal/bus and map out which packages publish on it", expected_intent: "explore", expected_agent: "coder" },
      { input: "survey the codebase for how many places call GetActive", expected_intent: "explore", expected_agent: "coder" },
      { input: "identify the entry points of the CLI and how they reach the daemon", expected_intent: "explore", expected_agent: "coder" },
      { input: "just look around the project and tell me its structure", expected_intent: "explore", expected_agent: "coder" },
      { input: "trace how a chat message flows from RPC to agent loop", expected_intent: "explore", expected_agent: "coder" },
      { input: "check what the tools in internal/gate do, no modifications", expected_intent: "explore", expected_agent: "coder" },
    ],
    security: [
      { input: "scan the repo for hardcoded API keys and secrets", expected_intent: "security", expected_agent: "security" },
      { input: "audit the auth middleware for permission bypass vulnerabilities", expected_intent: "security", expected_agent: "security" },
      { input: "review the TLS configuration for weak cipher suites", expected_intent: "security", expected_agent: "security" },
      { input: "check whether the SSRF guard on web_fetch covers IPv6 loopback", expected_intent: "security", expected_agent: "security" },
      { input: "threat-model the pairing handshake endpoint", expected_intent: "security", expected_agent: "security" },
      { input: "find injection risks in the SQL string building", expected_intent: "security", expected_agent: "security" },
      { input: "verify file permissions on dev_key and flag anything world-readable", expected_intent: "security", expected_agent: "security" },
      { input: "review the recent diff for secret leaks before it ships", expected_intent: "security", expected_agent: "security" },
    ],
    status: [
      { input: "is the regression gate run still going?", expected_intent: "status", expected_agent: "secretary" },
      { input: "how far along is the background build?", expected_intent: "status", expected_agent: "secretary" },
      { input: "did yesterday's scheduled job complete?", expected_intent: "status", expected_agent: "secretary" },
      { input: "what's the progress on the voice leaf?", expected_intent: "status", expected_agent: "secretary" },
      { input: "are there any jobs stuck in the queue right now?", expected_intent: "status", expected_agent: "secretary" },
      { input: "check if the episode for employee eng-1 finished or errored", expected_intent: "status", expected_agent: "secretary" },
      { input: "report running task status", expected_intent: "status", expected_agent: "secretary" },
      { input: "is the classifier boot gate healthy after the restart?", expected_intent: "status", expected_agent: "secretary" },
    ],
    write: [
      { input: "write a README for the gepa-tune tool explaining setup and usage", expected_intent: "write", expected_agent: "writer" },
      { input: "draft release notes for version 2.4 covering the voice changes", expected_intent: "write", expected_agent: "writer" },
      { input: "write documentation for the new intake.status RPC endpoint", expected_intent: "write", expected_agent: "writer" },
      { input: "polish this blog paragraph so it reads professionally", expected_intent: "write", expected_agent: "writer" },
      { input: "write a user-facing guide for the first-run pairing flow", expected_intent: "write", expected_agent: "writer" },
      { input: "produce changelog entries from these commit messages", expected_intent: "write", expected_agent: "writer" },
      { input: "write the API reference section for the voice.local.* RPCs", expected_intent: "write", expected_agent: "writer" },
      { input: "draft an announcement email about the new classifier runtime", expected_intent: "write", expected_agent: "writer" },
    ],
    architect: [
      { input: "design the architecture for a multi-region failover of the daemon", expected_intent: "architect", expected_agent: "architect" },
      { input: "what should the module boundaries be between effects and auditlog?", expected_intent: "architect", expected_agent: "architect" },
      { input: "decide whether parking turns belongs in the queue or a dedicated store", expected_intent: "architect", expected_agent: "architect" },
      { input: "design the protocol between the voice child and daemon for barge-in", expected_intent: "architect", expected_agent: "architect" },
      { input: "choose the storage engine for the semantic cache and justify it", expected_intent: "architect", expected_agent: "architect" },
      { input: "propose a layering for the new projects subsystem with dependency rules", expected_intent: "architect", expected_agent: "architect" },
      { input: "should the WS relay subscribe to typed topics or raw? argue the architecture", expected_intent: "architect", expected_agent: "architect" },
      { input: "architect the idempotency ledger so retries never double-send slack messages", expected_intent: "architect", expected_agent: "architect" },
    ],
    skeptic: [
      { input: "poke holes in this claim: GEPA beats RL at 100x lower sample cost", expected_intent: "skeptic", expected_agent: "skeptic" },
      { input: "what's wrong with my plan to cache LLM responses by prompt hash?", expected_intent: "skeptic", expected_agent: "skeptic" },
      { input: "adversarially review this design doc and find the failure modes", expected_intent: "skeptic", expected_agent: "skeptic" },
      { input: "challenge the assumption that loopback binding makes pairing secure", expected_intent: "skeptic", expected_agent: "skeptic" },
      { input: "try to break this validation logic: it checks file extension only", expected_intent: "skeptic", expected_agent: "skeptic" },
      { input: "tear apart the argument that we need a second listener for voice", expected_intent: "skeptic", expected_agent: "skeptic" },
      { input: "find what is weak about the claim that the gate passed twice so it is stable", expected_intent: "skeptic", expected_agent: "skeptic" },
      { input: "what would make this benchmark result fake or rigged?", expected_intent: "skeptic", expected_agent: "skeptic" },
    ],
    librarian: [
      { input: "organize the scattered reference docs into a coherent topic index", expected_intent: "librarian", expected_agent: "librarian" },
      { input: "curate the list of papers we cite in the research harness and dedupe it", expected_intent: "librarian", expected_agent: "librarian" },
      { input: "file these session notes into the right knowledge entries", expected_intent: "librarian", expected_agent: "librarian" },
      { input: "clean up the memory store: merge duplicates and archive stale entries", expected_intent: "librarian", expected_agent: "librarian" },
      { input: "build a reference catalog for all the arXiv ids in our docs", expected_intent: "librarian", expected_agent: "librarian" },
      { input: "sort the inbox transcripts into topics and tag each one", expected_intent: "librarian", expected_agent: "librarian" },
      { input: "audit the skills library and reorganize categories that overlap", expected_intent: "librarian", expected_agent: "librarian" },
      { input: "consolidate the three copies of the turn-taking spec into one", expected_intent: "librarian", expected_agent: "librarian" },
    ],
    imagegen: [
      { input: "generate an image of a fox curled up on a snowbank in watercolor style", expected_intent: "imagegen", expected_agent: "artist" },
      { input: "make me a picture of the meept mascot holding a wrench", expected_intent: "imagegen", expected_agent: "artist" },
      { input: "draw an isometric city block at dusk for the blog header", expected_intent: "imagegen", expected_agent: "artist" },
      { input: "create a logo banner with the text 'SOKRATES' in bold serif", expected_intent: "imagegen", expected_agent: "artist" },
      { input: "render a concept image of the earth-sheltered house exterior", expected_intent: "imagegen", expected_agent: "artist" },
      { input: "generate a sprite sheet of a walking robot in 64x64 pixels", expected_intent: "imagegen", expected_agent: "artist" },
      { input: "produce an illustration of two trees sharing one root system", expected_intent: "imagegen", expected_agent: "artist" },
      { input: "paint a portrait of an elderly lighthouse keeper, oil style", expected_intent: "imagegen", expected_agent: "artist" },
    ],
    videogen: [
      { input: "generate a 5 second clip of steam rising from a coffee cup", expected_intent: "videogen", expected_agent: "artist" },
      { input: "make a short video of the logo assembling itself letter by letter", expected_intent: "videogen", expected_agent: "artist" },
      { input: "create a looping background video of drifting clouds for the menu", expected_intent: "videogen", expected_agent: "artist" },
