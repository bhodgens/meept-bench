# bench run output (never the source tree; internal/results/ is a package).
# /results/* (contents) rather than /results/ (dir): a negation cannot
# re-include files under an excluded directory.
/results/*
# Baseline JSONLs ARE committed — they pin the diff gate (RUNBOOK "Baseline updates")
!results/baseline/
!results/baseline/**
suites/cache/
*.local.json
# LongMemEval adapter outputs (generated at run time from HF; never committed)
suites/longmemeval-*.generated.json
suites/lmeval-data/
# Deterministic cached-fetch fixtures (captured live by `meept-bench
# capture`, consumed by suites with tools.cached_fetch; machine-local
# per phase-2-3 P2.3).
/fixtures/
